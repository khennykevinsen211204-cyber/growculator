<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Growculator - Provider Calculator</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --sky:    #0f2540;
  --sky2:   #1a3a5c;
  --grass:  #4a9e2f;
  --grass2: #3d8226;
  --gold:   #ffd700;
  --gold2:  #ffaa00;
  --text:   #e8f4e8;
  --dim:    #7aaa8a;
  --green:  #6bd44a;
  --card:   rgba(8,22,12,0.78);
  --border: rgba(74,158,47,0.25);
}
*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html, body {
  background: linear-gradient(180deg, var(--sky) 0%, var(--sky2) 55%, #1e3d28 100%);
  color: var(--text); font-family: 'Nunito', sans-serif;
  min-height: 100vh; overflow-x: hidden;
}
.stars { position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
.star  { position:absolute; background:#fff; border-radius:50%;
  animation: twinkle var(--dur,3s) ease-in-out infinite; animation-delay:var(--delay,0s); }
@keyframes twinkle { 0%,100%{opacity:.1;} 50%{opacity:.75;} }
.bg-blocks { position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
.bg-block { position:absolute; width:26px; height:26px;
  border:2px solid rgba(255,255,255,0.05); border-radius:4px;
  font-size:15px; display:flex; align-items:center; justify-content:center;
  opacity:.09; animation:floatB var(--dur,8s) ease-in-out infinite; animation-delay:var(--delay,0s); }
@keyframes floatB { 0%,100%{transform:translateY(0) rotate(0);} 50%{transform:translateY(-12px) rotate(6deg);} }
nav {
  position: sticky; top:0; z-index:500; height:52px;
  display:flex; align-items:center; justify-content:space-between; padding:0 20px;
  background: rgba(10,25,40,0.92); backdrop-filter:blur(16px);
  border-bottom: 3px solid var(--grass);
  box-shadow: 0 3px 0 var(--grass2), 0 6px 20px rgba(0,0,0,0.4);
}
.brand { display:flex; align-items:center; gap:10px; }
.brand-icon {
  width:32px; height:32px; background:linear-gradient(135deg,var(--grass),#1d4a10);
  border-radius:8px; border:2px solid var(--grass2);
  box-shadow:inset 0 -3px 0 rgba(0,0,0,0.3),0 4px 10px rgba(74,158,47,0.3);
  display:flex; align-items:center; justify-content:center; font-size:16px;
}
.brand-name { font-family:'Press Start 2P',monospace; font-size:9px; letter-spacing:1px; line-height:1; }
.brand-name .g { color:var(--grass); } .brand-name .w { color:#fff; }
.brand-sub  { font-size:9px; font-weight:700; color:var(--dim); margin-top:2px; }
.nav-back {
  font-size:10px; font-weight:800; padding:5px 14px; border-radius:6px; cursor:pointer;
  background:transparent; border:2px solid rgba(255,255,255,0.1); color:var(--dim);
  text-decoration:none; transition:all .15s;
}
.nav-back:hover { border-color:rgba(255,255,255,0.28); color:#fff; }
.page { position:relative; z-index:10; max-width:760px; margin:0 auto; padding:24px 16px 60px; }
.ticker-wrap {
  display:flex; align-items:center;
  background:rgba(0,0,0,0.3); border:2px solid rgba(74,158,47,0.3);
  border-radius:10px; overflow:hidden; margin-bottom:22px;
}
.ticker-tag { flex-shrink:0; background:linear-gradient(180deg,var(--grass),var(--grass2));
  color:#fff; font-family:'Press Start 2P',monospace; font-size:6px; padding:7px 10px;
  letter-spacing:1px; border-right:2px solid rgba(255,255,255,0.1); }
.ticker-scroll { overflow:hidden; flex:1; padding:7px 0; }
.ticker-inner { display:inline-block; animation:ticker 16s linear infinite;
  font-size:10px; font-weight:800; color:#b8e8a0; white-space:nowrap; }
.ticker-inner span { padding:0 28px; }
@keyframes ticker { 0%{transform:translateX(0);} 100%{transform:translateX(-50%);} }
.provider-section {
  background: var(--card); border: 2px solid var(--border); border-radius: 16px;
  padding: 18px; backdrop-filter: blur(8px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.5); margin-bottom: 20px;
  animation: fadeUp .4s ease both;
}
@keyframes fadeUp { from{opacity:0;transform:translateY(14px);} to{opacity:1;transform:translateY(0);} }
.ps-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
.ps-title-row { display:flex; align-items:center; gap:8px; }
.ps-icon { font-size:20px; }
.ps-title { font-family:'Press Start 2P',monospace; font-size:9px; color:var(--gold);
  text-shadow:2px 2px 0 rgba(0,0,0,0.5); }
.ps-count { font-size:10px; font-weight:800; color:var(--dim);
  background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.07);
  border-radius:99px; padding:3px 10px; }
.ps-search-row { display:flex; gap:8px; margin-bottom:12px; }
.ps-search {
  flex:1; background:rgba(0,0,0,0.4); border:2px solid rgba(74,158,47,0.2);
  border-radius:8px; padding:8px 14px; color:var(--text);
  font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; outline:none;
  transition:border-color .2s;
}
.ps-search::placeholder { color:var(--dim); font-weight:600; }
.ps-search:focus { border-color:rgba(74,158,47,0.55); }
.ps-cats { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:14px; }
.ps-cat {
  font-size:10px; font-weight:800; padding:4px 12px; border-radius:99px; cursor:pointer;
  border:2px solid rgba(74,158,47,0.2); color:var(--dim); background:transparent;
  transition:all .15s;
}
.ps-cat:hover:not(.active) { border-color:rgba(74,158,47,0.4); color:var(--text); }
.ps-cat.active {
  background:linear-gradient(180deg,var(--grass),var(--grass2));
  border-color:var(--grass2); color:#fff; box-shadow:0 2px 0 var(--grass2);
}
.ps-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); gap:8px; }
.pcard {
  background:rgba(0,0,0,0.35); border:2px solid rgba(74,158,47,0.15);
  border-radius:12px; padding:12px 10px; cursor:pointer; position:relative; overflow:hidden;
  transition:all .18s; display:flex; flex-direction:column; align-items:center; gap:4px;
  animation:fadeUp .35s ease both;
}
.pcard:hover { border-color:rgba(74,158,47,0.45); background:rgba(74,158,47,0.08); transform:translateY(-2px); }
.pcard.active {
  border-color:var(--grass); background:rgba(74,158,47,0.15);
  box-shadow:0 0 16px rgba(74,158,47,0.2), inset 0 1px 0 rgba(255,255,255,0.05);
}
.pcard.soon { opacity:.45; cursor:not-allowed; }
.pcard.soon:hover { transform:none; border-color:rgba(74,158,47,0.15); background:rgba(0,0,0,0.35); }
.pcard-emoji { font-size:28px; line-height:1; }
.pcard-name  { font-size:11px; font-weight:800; color:#fff; text-align:center; line-height:1.2; }
.pcard-drop  { font-size:9px; font-weight:700; color:var(--dim); text-align:center; }
.pcard.active .pcard-drop { color:var(--green); }
.pcard-badge {
  position:absolute; top:6px; right:6px;
  font-size:7px; font-weight:800; padding:2px 5px; border-radius:4px; letter-spacing:.5px;
}
.badge-new  { background:rgba(74,158,47,0.25); border:1px solid rgba(74,158,47,0.4); color:var(--green); }
.badge-soon { background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:var(--dim); }
.badge-active {
  position:absolute; bottom:6px; right:6px; font-size:14px; line-height:1;
  animation:pulseCheck .8s ease-in-out infinite alternate;
}
@keyframes pulseCheck { from{opacity:.6;} to{opacity:1;} }
.ps-empty { text-align:center; padding:2rem; color:var(--dim); font-size:12px; font-weight:700; grid-column:1/-1; }
.ps-selected {
  display:flex; align-items:center; gap:10px;
  background:rgba(74,158,47,0.1); border:2px solid rgba(74,158,47,0.3);
  border-radius:10px; padding:10px 14px; margin-top:14px;
}
.ps-sel-emoji { font-size:24px; }
.ps-sel-info  { flex:1; }
.ps-sel-name  { font-size:13px; font-weight:800; color:#fff; }
.ps-sel-desc  { font-size:10px; font-weight:700; color:var(--dim); margin-top:2px; }
.ps-sel-badge {
  font-family:'Press Start 2P',monospace; font-size:7px; padding:4px 8px; border-radius:4px;
  background:rgba(74,158,47,0.25); border:1px solid rgba(74,158,47,0.4); color:var(--green);
}
.config-card {
  background:var(--card); border:2px solid var(--border); border-radius:14px;
  padding:16px; backdrop-filter:blur(8px);
  box-shadow:0 12px 40px rgba(0,0,0,0.5); margin-bottom:20px;
  animation:fadeUp .45s ease both;
}
.sec-header { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
.sec-icon   { font-size:20px; }
.sec-title  { font-family:'Press Start 2P',monospace; font-size:9px; color:var(--gold);
  text-shadow:2px 2px 0 rgba(0,0,0,0.5); }
.config-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
@media(max-width:480px){ .config-grid{grid-template-columns:1fr;} .ps-grid{grid-template-columns:repeat(3,1fr);} }
.field { display:flex; flex-direction:column; gap:5px; }
label { font-family:'Press Start 2P',monospace; font-size:6px; letter-spacing:1px; color:var(--dim); text-transform:uppercase; }
input[type=number] {
  width:100%; background:rgba(0,0,0,0.4); border:2px solid rgba(74,158,47,0.2);
  border-radius:8px; padding:8px 12px; color:var(--text);
  font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; outline:none;
  text-align:center; transition:border-color .2s; -webkit-appearance:none; appearance:none;
}
input[type=number]:focus { border-color:rgba(74,158,47,0.6); box-shadow:0 0 0 3px rgba(74,158,47,0.1); }
.results-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin-bottom:20px; }
@media(max-width:480px){ .results-grid{grid-template-columns:1fr;} }
.ric {
  background:var(--card); border:2px solid var(--border); border-radius:12px;
  padding:12px 14px; backdrop-filter:blur(6px);
  animation:fadeUp .4s ease both; transition:border-color .2s, transform .15s;
}
.ric:hover { border-color:rgba(74,158,47,0.45); transform:translateY(-2px); }
.ric-top  { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.ric-name { font-size:12px; font-weight:800; color:#fff; }
.ric-sub  { font-size:9px; font-weight:700; color:var(--dim); }
.ric-qty  { font-family:'Press Start 2P',monospace; font-size:14px;
  color:var(--gold); text-shadow:0 0 10px rgba(255,215,0,0.3),2px 2px 0 rgba(0,0,0,0.5); }
.ric-pct  { font-size:9px; font-weight:700; color:var(--dim); margin-top:3px; }

/* ══ CRAFTING BUTTON ══ */
.ric-crafting {
  background:var(--card); border:2px solid var(--border); border-radius:12px;
  padding:12px 14px; backdrop-filter:blur(6px);
  animation:fadeUp .4s ease both; transition:border-color .2s, transform .15s;
  display:flex; flex-direction:row; align-items:center; justify-content:flex-start;
  gap:8px; cursor:pointer;
}
.ric-crafting:hover { 
  border-color:rgba(74,158,47,0.45); 
  transform:translateY(-2px);
  background:rgba(74,158,47,0.08);
}
.ric-crafting-icon { font-size:18px; flex-shrink:0; }
.ric-crafting-text { font-size:11px; font-weight:700; color:var(--dim); white-space:nowrap; }

.single-result {
  background:var(--card); border:2px solid var(--border); border-radius:12px;
  padding:16px; text-align:center; backdrop-filter:blur(6px);
  margin-bottom:20px; animation:fadeUp .4s ease both;
}
.single-result .qty { font-family:'Press Start 2P',monospace; font-size:22px;
  color:var(--gold); text-shadow:0 0 12px rgba(255,215,0,0.3),2px 2px 0 rgba(0,0,0,0.5);
  display:block; margin:8px 0 4px; }
.single-result .item-name { font-size:13px; font-weight:800; color:var(--dim); }
.profit-card {
  background:var(--card); border:2px solid var(--border); border-radius:14px;
  padding:16px; backdrop-filter:blur(8px);
  box-shadow:0 12px 40px rgba(0,0,0,0.5); margin-bottom:16px;
  animation:fadeUp .5s ease both;
}
.total-revenue-bar {
  display:flex; align-items:center; justify-content:space-between;
  background:rgba(0,0,0,0.3); border:2px solid rgba(74,158,47,0.15);
  border-radius:10px; padding:12px 16px; margin-bottom:16px;
}
.trb-label { font-family:'Press Start 2P',monospace; font-size:7px; color:var(--dim); letter-spacing:1px; }
.trb-val   { font-family:'Press Start 2P',monospace; font-size:14px;
  color:var(--green); text-shadow:0 0 12px rgba(107,212,74,0.4),2px 2px 0 rgba(0,0,0,0.5);
  display:flex; align-items:center; gap:8px; }
.trb-wl { font-size:18px; }
.price-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
@media(max-width:480px){ .price-grid{grid-template-columns:1fr;} }
.pic {
  background:rgba(0,0,0,0.3); border:2px solid rgba(74,158,47,0.12);
  border-radius:10px; padding:12px; transition:border-color .2s;
}
.pic:focus-within { border-color:rgba(74,158,47,0.4); }
.pic-header { display:flex; align-items:center; gap:7px; margin-bottom:3px; }
.pic-name   { font-size:11px; font-weight:800; color:#fff; }
.pic-total  { font-size:10px; font-weight:700; color:var(--dim); margin-bottom:8px; }
.pic-price-row { display:flex; gap:6px; align-items:center; }
.pic-price-label { font-family:'Press Start 2P',monospace; font-size:6px; color:var(--dim); letter-spacing:1px; white-space:nowrap; }
.pic-sw { position:relative; flex-shrink:0; }
.pic-sw::after { content:'▾'; position:absolute; right:6px; top:50%; transform:translateY(-50%);
  font-size:9px; color:var(--grass); pointer-events:none; }
.pic-sw select {
  width:auto; padding:5px 20px 5px 7px; font-size:10px; border-radius:6px;
  background:rgba(0,0,0,0.4); border:2px solid rgba(74,158,47,0.2); color:var(--text);
  font-family:'Nunito',sans-serif; font-weight:700; outline:none; cursor:pointer;
  -webkit-appearance:none; appearance:none;
}
.pic-input {
  flex:1; background:rgba(0,0,0,0.4); border:2px solid rgba(74,158,47,0.2);
  border-radius:6px; padding:5px 8px; color:var(--text);
  font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; outline:none;
  text-align:center; transition:border-color .2s; -webkit-appearance:none; appearance:none;
}
.pic-input:focus { border-color:rgba(74,158,47,0.55); }
.pic-profit { font-family:'Press Start 2P',monospace; font-size:9px; margin-top:6px; text-align:right; }
.single-profit-area {
  background:rgba(0,0,0,0.3); border:2px solid rgba(74,158,47,0.15);
  border-radius:10px; padding:14px;
}
.sp-row { display:flex; align-items:center; gap:8px; margin-bottom:4px; }
.sp-label { font-family:'Press Start 2P',monospace; font-size:7px; color:var(--dim); white-space:nowrap; }
.sp-sw { position:relative; }
.sp-sw::after { content:'▾'; position:absolute; right:7px; top:50%; transform:translateY(-50%);
  font-size:10px; color:var(--grass); pointer-events:none; }
.sp-sw select {
  width:auto; padding:6px 22px 6px 8px; font-size:11px; border-radius:6px;
  background:rgba(0,0,0,0.4); border:2px solid rgba(74,158,47,0.2); color:var(--text);
  font-family:'Nunito',sans-serif; font-weight:700; outline:none; cursor:pointer;
  -webkit-appearance:none; appearance:none;
}
.sp-input {
  flex:1; background:rgba(0,0,0,0.4); border:2px solid rgba(74,158,47,0.2);
  border-radius:6px; padding:6px 10px; color:var(--text);
  font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; outline:none;
  text-align:center; transition:border-color .2s; -webkit-appearance:none; appearance:none;
}
.sp-input:focus { border-color:rgba(74,158,47,0.55); }
.btn-reset {
  width:100%; padding:11px;
  background:linear-gradient(180deg,rgba(239,68,68,.15),rgba(180,40,40,.15));
  border:2px solid rgba(239,68,68,.3); border-radius:8px;
  color:#ff8888; font-family:'Nunito',sans-serif; font-size:11px; font-weight:800;
  letter-spacing:1px; text-transform:uppercase; cursor:pointer;
  transition:all .15s; display:flex; align-items:center; justify-content:center; gap:6px;
  box-shadow:0 3px 0 rgba(0,0,0,.3);
}
.btn-reset:hover { background:linear-gradient(180deg,rgba(239,68,68,.28),rgba(180,40,40,.28));
  border-color:rgba(239,68,68,.55); transform:translateY(-1px); }
.btn-reset:active { transform:translateY(2px); }
@keyframes slideInFromRight { from{opacity:0;transform:translateX(400px);} to{opacity:1;transform:translateX(0);} }
@keyframes slideOutToRight  { from{opacity:1;transform:translateX(0);}   to{opacity:0;transform:translateX(400px);} }
.notification-toast {
  position:fixed; top:80px; right:20px; padding:16px 20px; border-radius:8px;
  font-size:13px; font-weight:700; z-index:2000; max-width:320px;
  box-shadow:0 8px 24px rgba(0,0,0,0.5); animation:slideInFromRight .3s ease forwards;
  white-space:pre-wrap; word-wrap:break-word; line-height:1.5;
}
.notification-toast.error   { background:linear-gradient(135deg,#f44336,#d32f2f); color:#fff; border:2px solid #ff6b6b; }
.notification-toast.success { background:linear-gradient(135deg,#4caf50,#388e3c); color:#fff; border:2px solid #66bb6a; }
.notification-toast.warning { background:linear-gradient(135deg,#ff9800,#f57c00); color:#fff; border:2px solid #ffb74d; }
.notification-toast.hide    { animation:slideOutToRight .3s ease forwards; }
@media(max-width:480px){ .notification-toast{top:60px;right:10px;left:10px;max-width:none;} }

.ps-icon-img{
  width:24px; height:24px; object-fit:contain; image-rendering:pixelated; flex-shrink:0;
}
.sec-icon-img{
  width:24px; height:24px; object-fit:contain; image-rendering:pixelated; flex-shrink:0;
}

/* ══ CRAFTING MODAL ══ */
.modal-overlay {
  position:fixed; inset:0; z-index:3000;
  background:rgba(0,0,0,0.75); backdrop-filter:blur(6px);
  display:flex; align-items:center; justify-content:center; padding:16px;
  animation:fadeIn .2s ease;
}
@keyframes fadeIn { from{opacity:0;} to{opacity:1;} }
.modal-box {
  background:linear-gradient(180deg,#0d2235,#0a1a10);
  border:2px solid rgba(74,158,47,0.4); border-radius:18px;
  width:100%; max-width:520px; height:80vh; max-height:640px;
  display:flex; flex-direction:column;
  box-shadow:0 24px 60px rgba(0,0,0,0.7), 0 0 40px rgba(74,158,47,0.08);
  animation:slideUp .25s ease;
}
@keyframes slideUp { from{opacity:0;transform:translateY(24px);} to{opacity:1;transform:translateY(0);} }
.modal-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:16px 20px; border-bottom:2px solid rgba(74,158,47,0.15); flex-shrink:0;
}
.modal-title { font-family:'Press Start 2P',monospace; font-size:9px; color:var(--gold); letter-spacing:1px; }
.modal-close {
  width:30px; height:30px; border-radius:8px; cursor:pointer;
  background:rgba(239,68,68,0.15); border:2px solid rgba(239,68,68,0.3);
  color:#ff8888; font-size:16px; display:flex; align-items:center; justify-content:center;
  transition:all .15s;
}
.modal-close:hover { background:rgba(239,68,68,0.3); }
.modal-body { overflow-y:auto; padding:16px 20px 20px; flex:1; }
.modal-harvest-bar {
  display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px; padding:10px 12px;
  background:rgba(0,0,0,0.3); border:1px solid rgba(74,158,47,0.15); border-radius:10px;
}
.mhb-item { display:flex; align-items:center; gap:4px; }
.mhb-img { width:18px; height:18px; object-fit:contain; image-rendering:pixelated; }
.mhb-val { font-family:'Press Start 2P',monospace; font-size:7px; }
.mhb-sep { font-size:10px; color:rgba(255,255,255,0.15); }
.craft-list { display:flex; flex-direction:column; gap:8px; }
.craft-item {
  background:rgba(0,0,0,0.3); border:2px solid rgba(74,158,47,0.12);
  border-radius:12px; padding:12px 14px; display:flex; align-items:center; gap:12px;
  animation:fadeUp .3s ease both;
}
.craft-item.craftable { border-color:rgba(74,158,47,0.35); }
.craft-item.uncraftable { opacity:.45; }

/* ── UPDATED: craft-icon supports both emoji and img ── */
.craft-icon {
  font-size:26px; flex-shrink:0;
  width:36px; height:36px;
  display:flex; align-items:center; justify-content:center;
}
.craft-icon img {
  width:36px; height:36px;
  object-fit:contain; image-rendering:pixelated;
}

.craft-info { flex:1; min-width:0; }
