            <select id="sp_mode" onchange="recalcSingle(${qty})">
              <option value="per"  ${savedMode==='per' ?'selected':''}>per</option>
              <option value="each" ${savedMode==='each'?'selected':''}>each</option>
            </select>
          </div>
          <input class="sp-input" type="number" id="sp_price" value="${savedPrice}" min="0"
            oninput="recalcSingle(${qty})"
            onfocus="if(this.value==='0')this.value=''"
            onblur="if(this.value==='')this.value='0'" placeholder="0">
        </div>
      </div>`;
    recalcSingle(qty);

  } else {
    const totalRolls = Math.round(total * siklus);
    const drops      = distributeDrops(totalRolls, p.drops);
    window._lastDrops = drops;

    let hHtml = '<div class="results-grid">';
    drops.forEach((d,i) => {
      hHtml += `<div class="ric" style="animation-delay:${i*0.05}s">
        <div class="ric-top">
          ${renderDropIcon(d,'20px')}
          <div><div class="ric-name">${d.name}</div><div class="ric-sub">Estimated drop</div></div>
        </div>
        <div class="ric-qty">${d.qty.toLocaleString('en-US')}</div>
      </div>`;
    });

    if(p.key === 'science_station') {
      hHtml += `<div class="ric-crafting" onclick="openCraftingModal(window._lastDrops)">
        <div class="ric-crafting-icon">⚗️</div>
        <div class="ric-crafting-text">What Can Be Crafted</div>
      </div>`;
    }

    hHtml += '</div>';
    harvestEl.innerHTML = hHtml;

    let pHtml = '<div class="price-grid">';
    drops.forEach(d => {
      const sm = document.getElementById('mode_'+d.key)?.value  || 'per';
      const sp = document.getElementById('price_'+d.key)?.value || '0';
      const pr = calcProfit(d.qty, sm, parseFloat(sp)||0);
      pHtml += `<div class="pic">
        <div class="pic-header">
          ${renderDropIcon(d,'16px')}
          <span class="pic-name">${d.name}</span>
        </div>
        <div class="pic-total">${d.qty.toLocaleString('en-US')} total</div>
        <div class="pic-price-row">
          <span class="pic-price-label">PRICE</span>
          <div class="pic-sw">
            <select id="mode_${d.key}" onchange="recalcMulti()">
              <option value="per"  ${sm==='per' ?'selected':''}>per</option>
              <option value="each" ${sm==='each'?'selected':''}>each</option>
            </select>
          </div>
          <input class="pic-input" type="number" id="price_${d.key}" value="${sp}" min="0"
            oninput="recalcMulti()"
            onfocus="if(this.value==='0')this.value=''"
            onblur="if(this.value==='')this.value='0'" placeholder="0">
        </div>
        <div class="pic-profit" id="profit_${d.key}" style="color:${d.color};">
          ${pr.toLocaleString('en-US',{maximumFractionDigits:2})} WL
        </div>
      </div>`;
    });
    pHtml += '</div>';
    profitEl.innerHTML = pHtml;
    recalcMulti();
  }
}

function calcProfit(qty, mode, price){
  if(price <= 0) return 0;
  return mode === 'each' ? qty * price : qty / price;
}
function recalcSingle(qty){
  const mode  = document.getElementById('sp_mode')?.value  || 'per';
  const price = parseFloat(document.getElementById('sp_price')?.value) || 0;
  document.getElementById('total_revenue').textContent =
    calcProfit(qty,mode,price).toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:2})+' WL';
}
function recalcMulti(){
  const p      = allProviders.find(x=>x.key===currentKey);
  const total  = parseFloat(document.getElementById('total_providers').value) || 0;
  const siklus = parseInt(document.getElementById('kali_harvest').value) || 1;
  const drops  = distributeDrops(Math.round(total * siklus), p.drops);
  let grand = 0;
  drops.forEach(d => {
    const mode  = document.getElementById('mode_'+d.key)?.value  || 'per';
    const price = parseFloat(document.getElementById('price_'+d.key)?.value) || 0;
    const pr    = calcProfit(d.qty, mode, price);
    grand += pr;
    const el = document.getElementById('profit_'+d.key);
    if(el) el.textContent = pr.toLocaleString('en-US',{maximumFractionDigits:2})+' WL';
  });
  document.getElementById('total_revenue').textContent =
    grand.toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:2})+' WL';
}
function resetKalkulator(){
  document.getElementById('total_providers').value = '0';
  document.getElementById('kali_harvest').value    = '1';
  hitungOtomatis();
}

renderProviderGrid();
selectProvider('chicken');

/* ══════════════════════════════════════════════════════
   CRAFTING SYSTEM — Science Station
   ══════════════════════════════════════════════════════ */

const CHEM_META = {
  chem_g: { name:'G', color:'#4ade80', img:'https://cdn.growtopiawiki.com/sprites/914.png' },
  chem_r: { name:'R', color:'#f87171', img:'https://cdn.growtopiawiki.com/sprites/916.png' },
  chem_y: { name:'Y', color:'#fde047', img:'https://cdn.growtopiawiki.com/sprites/924.png' },
  chem_b: { name:'B', color:'#60a5fa', img:'https://cdn.growtopiawiki.com/sprites/920.png' },
  chem_p: { name:'P', color:'#c084fc', img:'https://cdn.growtopiawiki.com/sprites/918.png' },
};

/* ══════════════════════════════════════════
   CRAFTING RECIPES — dengan field img
   Sprite ID referensi dari growtopiawiki.com
   ══════════════════════════════════════════ */
const craftingRecipes = [
  { name:'Combover',            emoji:'💈', img:'https://cdn.growtopiawiki.com/sprites/770.png', recipe:{ chem_g:1,  chem_r:5,  chem_y:2  }, quantity:1 },
  { name:'Shocking Hair',       emoji:'💥', img:'https://cdn.growtopiawiki.com/sprites/906.png', recipe:{ chem_g:30, chem_r:4,  chem_b:1  }, quantity:1 },
  { name:'Shockinator',         emoji:'⚡', img:'https://cdn.growtopiawiki.com/sprites/902.png',  recipe:{ chem_r:2,  chem_y:1              }, quantity:3 },
  { name:'Steel Table',         emoji:'🪑', img:'https://cdn.growtopiawiki.com/sprites/926.png',  recipe:{ chem_g:2,  chem_b:3              }, quantity:5 },
  { name:'Dragon Tail',         emoji:'🐉', img:'https://cdn.growtopiawiki.com/sprites/1114.png', recipe:{ chem_r:1,  chem_y:3,  chem_p:2  }, quantity:1 },
  { name:'Slime',               emoji:'💛', img:'https://cdn.growtopiawiki.com/sprites/978.png',  recipe:{ chem_g:1,  chem_y:2,  chem_b:1  }, quantity:4 },
  { name:'Lab Coat',            emoji:'🥼', img:'https://cdn.growtopiawiki.com/sprites/772.png',  recipe:{ chem_g:2,  chem_r:1,  chem_p:1  }, quantity:1 },
  { name:'Ze Goggles',          emoji:'🥽', img:'https://cdn.growtopiawiki.com/sprites/904.png',  recipe:{ chem_b:2,  chem_y:1              }, quantity:1 },
  { name:'Mysterious Chemical', emoji:'🧪', img:'https://cdn.growtopiawiki.com/sprites/922.png',  recipe:{ chem_y:20, chem_b:10, chem_p:5  }, quantity:1 },
];

const MC_RECIPE = { chem_y:20, chem_b:10, chem_p:5 };

const craftingRecipes2 = [
  { name:'Forcefield',         emoji:'🛡️', img:'https://cdn.growtopiawiki.com/sprites/1162.png',  quantity:1,  mystChem:1,   recipe:{ chem_g:20, chem_r:10   } },
  { name:'Fuel Pack',          emoji:'⛽', img:'https://cdn.growtopiawiki.com/sprites/1746.png',  quantity:5,  mystChem:1,   recipe:{ chem_g:10, chem_b:2    } },
  { name:'Battle Trout',       emoji:'🐟', img:'https://cdn.growtopiawiki.com/sprites/1542.png',  quantity:1,  mystChem:10,  recipe:{ chem_g:20, chem_p:15   } },
  { name:'Sassy Boots',        emoji:'👢', img:'https://cdn.growtopiawiki.com/sprites/2588.png',  quantity:1,  mystChem:1,   recipe:{ chem_r:8,  chem_y:4    } },
  { name:'Block Glue',         emoji:'🧱', img:'https://cdn.growtopiawiki.com/sprites/1866.png',  quantity:10, mystChem:1,   recipe:{ chem_r:1,  chem_p:1    } },
  { name:'Enhanced Intellect', emoji:'🧠', img:'https://cdn.growtopiawiki.com/sprites/908.png',  quantity:1,  mystChem:3,   recipe:{ chem_y:3,  chem_b:3    } },
  { name:'Thingamajig',        emoji:'⚙️', img:'https://cdn.growtopiawiki.com/sprites/1310.png',  quantity:1,  mystChem:1,   recipe:{ chem_y:4,  chem_p:3    } },
  { name:'Reanimator Remote',  emoji:'📡', img:'https://cdn.growtopiawiki.com/sprites/910.png',  quantity:1,  mystChem:200, recipe:{ chem_b:200, chem_p:200 } },
];

/* ── Core formula ── */
function calculateCraftable(harvestMap, recipe) {
  let minQty = Infinity;
  for (const [chemKey, needed] of Object.entries(recipe)) {
    const available = harvestMap[chemKey] || 0;
    minQty = Math.min(minQty, Math.floor(available / needed));
  }
  return minQty === Infinity ? 0 : minQty;
}

function expandRecipe(item) {
  const expanded = { ...item.recipe };
  for (const [chem, amt] of Object.entries(MC_RECIPE)) {
    expanded[chem] = (expanded[chem] || 0) + item.mystChem * amt;
  }
  return expanded;
}

/* ── Render craft icon: img dengan fallback ke emoji ── */
function renderCraftIcon(item) {
  if (item.img && item.img.trim()) {
    return `<img src="${item.img}" alt="${item.name}"
      onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
      <span style="display:none;font-size:26px;line-height:1;">${item.emoji}</span>`;
  }
  return `<span style="font-size:26px;line-height:1;">${item.emoji}</span>`;
}

function renderCraftItem(item, recipeHtml, canMake, accentColor, idx) {
  const craftable    = canMake > 0;
  const totalProduce = canMake * item.quantity;
  return `
    <div class="craft-item ${craftable?'craftable':'uncraftable'}" style="animation-delay:${idx*0.04}s">
      <div class="craft-icon">${renderCraftIcon(item)}</div>
      <div class="craft-info">
        <div class="craft-name">${item.name}</div>
        ${recipeHtml}
      </div>
      <div class="craft-qty-col">
        <div class="craft-qty" style="color:${craftable ? accentColor : '#4b5563'}">${canMake}×</div>
        ${item.quantity > 1 ? `<div class="craft-produce">${totalProduce.toLocaleString('en-US')} items</div>` : ''}
      </div>
    </div>`;
}

function chemTags(recipeObj) {
  return Object.entries(recipeObj).map(([key, amt]) => {
    const m = CHEM_META[key];
    const imgHtml = m.img
      ? `<img src="${m.img}" alt="${m.name}" style="width:13px;height:13px;object-fit:contain;image-rendering:pixelated;flex-shrink:0;" onerror="this.style.display='none'">`
      : '';
    return `<span class="chem-tag" style="color:${m.color};border-color:${m.color}33;display:inline-flex;align-items:center;gap:3px;">${imgHtml}${m.name}×${amt}</span>`;
  }).join('');
}

function buildSlide1Html(harvestMap) {
  return craftingRecipes.map((item, idx) => {
    const canMake  = calculateCraftable(harvestMap, item.recipe);
    const rHtml    = `<div class="craft-recipe">${chemTags(item.recipe)}</div>`;
    return renderCraftItem(item, rHtml, canMake, '#6bd44a', idx);
  }).join('');
}

function buildSlide2Html(harvestMap) {
  return craftingRecipes2.map((item, idx) => {
    const expanded = expandRecipe(item);
    const canMake  = calculateCraftable(harvestMap, expanded);
    const rHtml    = `
      <div class="craft-recipe" style="margin-bottom:3px">
        ${chemTags(item.recipe)}
        <span class="mc-badge" style="display:inline-flex;align-items:center;gap:3px;"><img src="https://cdn.growtopiawiki.com/sprites/922.png" alt="MC" style="width:13px;height:13px;object-fit:contain;image-rendering:pixelated;flex-shrink:0;" onerror="this.style.display='none'">×${item.mystChem}</span>
      </div>
      <div class="craft-recipe" style="opacity:.55">
        <span style="font-size:8px;color:var(--dim);margin-right:2px;">↳</span>
        ${chemTags(expanded)}
      </div>`;
    return renderCraftItem(item, rHtml, canMake, '#fb923c', idx);
  }).join('');
}

function openCraftingModal(drops) {
  const harvestMap = {};
  drops.forEach(d => { harvestMap[d.key] = d.qty; });

  const harvestBarHtml = Object.entries(CHEM_META).map(([key, meta], i, arr) =>
    `<div class="mhb-item">
      <img class="mhb-img" src="${meta.img}" alt="${meta.name}" onerror="this.style.display='none'">
      <span class="mhb-val" style="color:${meta.color}">${(harvestMap[key]||0).toLocaleString('en-US')}</span>
    </div>${i < arr.length-1 ? '<span class="mhb-sep">·</span>' : ''}`
  ).join('');

  const s1Html   = buildSlide1Html(harvestMap);
  const s2Html   = buildSlide2Html(harvestMap);
  const s1Count  = craftingRecipes.filter(i  => calculateCraftable(harvestMap, i.recipe) > 0).length;
  const s2Count  = craftingRecipes2.filter(i => calculateCraftable(harvestMap, expandRecipe(i)) > 0).length;

  const modal = document.createElement('div');
  modal.className = 'modal-overlay';
  modal.id = 'crafting-modal';
  modal.innerHTML = `
    <div class="modal-box">
      <div class="modal-header">
        <span class="modal-title">⚗️ What Can Be Crafted</span>
        <button class="modal-close" onclick="closeCraftingModal()">✕</button>
      </div>
      <div class="modal-tabs">
        <button class="modal-tab active" id="tab-s1" onclick="switchCraftTab(1)">Option 1</button>
        <button class="modal-tab"        id="tab-s2" onclick="switchCraftTab(2)">Option 2</button>
      </div>
      <div class="modal-harvest-bar" style="margin:10px 16px 0;border-radius:8px;flex-shrink:0;">
        ${harvestBarHtml}
      </div>
      <div class="modal-slide active" id="craft-slide-1">
        <div class="craft-list">${s1Html}</div>
      </div>
      <div class="modal-slide" id="craft-slide-2">
        <div class="mc-expand-note">
          🧪 Items below need <strong>Mysterious Chemical</strong> (Y×20 · B×10 · P×5).<br>
          Qty is auto-balanced — chemicals shared across MC + item recipe.
        </div>
        <div class="craft-list">${s2Html}</div>
      </div>
      <div class="modal-footer" id="craft-footer">
        ${s1Count} of ${craftingRecipes.length} items craftable
      </div>
    </div>`;

  modal._s1footer = `${s1Count} of ${craftingRecipes.length} items craftable`;
  modal._s2footer = `${s2Count} of ${craftingRecipes2.length} MC items craftable`;

  modal.addEventListener('click', e => { if(e.target === modal) closeCraftingModal(); });
  document.body.appendChild(modal);
}

function switchCraftTab(n) {
  const modal = document.getElementById('crafting-modal');
  document.getElementById('craft-slide-1').classList.toggle('active', n === 1);
  document.getElementById('craft-slide-2').classList.toggle('active', n === 2);
  document.getElementById('tab-s1').classList.toggle('active', n === 1);
  document.getElementById('tab-s2').classList.toggle('active', n === 2);
  document.getElementById('craft-footer').textContent = n === 1 ? modal._s1footer : modal._s2footer;
}

function closeCraftingModal() {
  const modal = document.getElementById('crafting-modal');
  if(modal) { modal.style.animation = 'fadeIn .15s ease reverse'; setTimeout(() => modal.remove(), 150); }
}
</script>
