function distributeDrops(totalRolls, drops) {
  const result = drops.map(d => ({ ...d, qty: Math.floor(totalRolls * d.rate) }));
  const used      = result.reduce((s, d) => s + d.qty, 0);
  const remainder = Math.round(totalRolls - used);
  if (remainder > 0) {
    const maxIdx = result.reduce((mi, d, i, a) => d.rate > a[mi].rate ? i : mi, 0);
    result[maxIdx].qty += remainder;
  }
  return result;
}

