function validateInputs(){
  const errors = [];
  const total  = document.getElementById('total_providers').value.trim();
  const siklus = document.getElementById('kali_harvest').value.trim();
  if(!total)           errors.push('Total provider tidak boleh kosong');
  else if(isNaN(total)) errors.push('Total provider harus berupa angka');
  else {
    const n = parseFloat(total);
    if(n < 0)      errors.push('Total provider tidak boleh negatif');
    if(n > 999999) errors.push('Total provider terlalu besar (max 999.999)');
  }
  if(!siklus)            errors.push('Harvest cycles tidak boleh kosong');
  else if(isNaN(siklus)) errors.push('Harvest cycles harus berupa angka');
  else {
    const n = parseInt(siklus);
    if(n < 1)   errors.push('Harvest cycles minimal 1');
    if(n > 365) errors.push('Harvest cycles tidak boleh lebih dari 365');
  }
  return { valid: errors.length===0, errors };
}
function showNotification(message, type='error', duration=4000){
  const existing = document.querySelector('.notification-toast:not(.hide)');
  if(existing){ existing.classList.add('hide'); setTimeout(()=>existing.remove(),300); }
  const toast = document.createElement('div');
  toast.className = `notification-toast ${type}`;
  toast.textContent = `${type==='success'?'✅':type==='warning'?'⚠️':'❌'} ${message}`;
  document.body.appendChild(toast);
  if(duration>0) setTimeout(()=>{ toast.classList.add('hide'); setTimeout(()=>toast.remove(),300); }, duration);
}
function clearNotifications(){
  document.querySelectorAll('.notification-toast').forEach(t=>{
    t.classList.add('hide'); setTimeout(()=>t.remove(),300);
  });
}

function hitungOtomatis(){
  const validation = validateInputs();
  if(!validation.valid){
    showNotification(validation.errors.join('\n'), 'error', 5000);
    return;
  }
  clearNotifications();

  const p       = allProviders.find(x=>x.key===currentKey);
  const total   = parseFloat(document.getElementById('total_providers').value);
  const siklus  = parseInt(document.getElementById('kali_harvest').value);
  const harvestEl = document.getElementById('harvest_results_area');
  const profitEl  = document.getElementById('profit_inputs_area');

  if(!p.multiDrop){
